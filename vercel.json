{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build:site --prefix web",
  "outputDirectory": "web/dist",
  "functions": {
    "api/audit.js": {
      "maxDuration": 60
    },
    "api/site.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/id",
      "destination": "/id/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
