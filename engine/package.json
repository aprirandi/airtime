{
  "name": "airtime-engine",
  "private": true,
  "version": "0.1.0",
  "description": "The Auditor's engine in TypeScript: runs in a Vercel function. Checked against the Python engine with golden files.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "tsx scripts/serve.mts",
    "bundle:api": "esbuild src/node.ts --bundle --platform=node --target=node20 --format=cjs --legal-comments=none --footer:js=\"module.exports=module.exports.default||module.exports;\" --outfile=../api/audit.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "undici": "^6.29.1"
  }
}
